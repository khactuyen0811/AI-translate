// Quy trình dịch thuật Word tổng quát
digraph Universal_Doc_Translator {
	rankdir=TB size="10,12"
	START [label="BẮT ĐẦU
(Nạp Model AI & File Word bất kỳ)" color=blue shape=ellipse]
	EXTRACT [label="TRÍCH XUẤT DỮ LIỆU
(Duyệt Paragraphs & Table Cells)" shape=box]
	SKIP_CHECK [label="BỘ LỌC ĐỊNH DẠNG
(Né Mục lục, số trang,
dấu chấm dài, dòng trống)" color=orange shape=diamond]
	AI_PROMPT [label="GỬI AI XỬ LÝ
(Prompt ép buộc: \"Dịch hoặc
giữ nguyên gốc\")" color=purple shape=box]
	REFUSAL_FILTER [label="KIỂM TRA NỘI DUNG
(Phát hiện \"I cannot\", \"unable\"...)" color=red shape=diamond]
	REVERT [label="KHÔI PHỤC BẢN GỐC
(Nếu AI từ chối dịch)" color=lightgrey shape=box style=filled]
	CLEAN [label="LỌC NÓI LEO
(Xóa \"Sure\", \"Here is...\")" shape=box]
	WRITE [label="GHI VÀO FILE
(Tác động vào \"Runs\" để
giữ nguyên căn lề & font)" color=green shape=box]
	END [label="XUẤT FILE HOÀN THIỆN" color=blue shape=ellipse]
	START -> EXTRACT
	EXTRACT -> SKIP_CHECK
	SKIP_CHECK -> AI_PROMPT [label="Văn bản hợp lệ"]
	SKIP_CHECK -> EXTRACT [label="Là rác/định dạng (Bỏ qua)"]
	AI_PROMPT -> REFUSAL_FILTER
	REFUSAL_FILTER -> REVERT [label="Nếu AI từ chối"]
	REFUSAL_FILTER -> CLEAN [label="Nếu AI dịch tốt"]
	REVERT -> WRITE
	CLEAN -> WRITE
	WRITE -> EXTRACT [label="Tiếp tục cho đến hết file"]
	EXTRACT -> END [label="Đã duyệt hết 100%"]
}
